{
  "name": "orchestore",
  "version": "0.1.7",
  "description": "A function-oriented architecture built on top of Redux Toolkit for simplifying and automating application development.",
  "author": "Oussama Saadaoui",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "init": "node scripts/install.mjs",
    "start": "tsup && node scripts/build.mjs",
    "build": "tsup && node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "deploy": "tsup && node scripts/publish.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/saadaoui-oussama-dev/OrcheStore#readme",
  "bugs": {
    "url": "https://github.com/saadaoui-oussama-dev/OrcheStore/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saadaoui-oussama-dev/OrcheStore.git"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^16.9.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.9.0 || ^17 || ^18 || ^19"
  },
  "keywords": [
    "orchestore",
    "store",
    "slice",
    "state",
    "global-store",
    "global-state",
    "typed-store",
    "typed-state",
    "react",
    "react-store",
    "react-state",
    "react-redux",
    "redux",
    "redux-toolkit",
    "redux-automation",
    "frontend",
    "typescript",
    "orchestration",
    "state-management",
    "state-orchestration",
    "pinia",
    "vuex",
    "react-pinia",
    "react-vuex",
    "redux-pinia",
    "redux-vuex",
    "store-pinia",
    "store-vuex"
  ]
}
